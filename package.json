{
  "name": "construct-ai",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test && pnpm test:config && pnpm test:http && pnpm test:storage && python3 -m unittest discover -s tests -v",
    "verify:framework": "python3 scripts/verify_autonomous_framework.py",
    "preflight": "python3 scripts/preflight.py",
    "smoke:worker": "pnpm --filter @construct-ai/worker smoke",
    "local:config": "node --env-file-if-exists=.env --experimental-strip-types scripts/check-local-config.ts",
    "test:config": "node --experimental-strip-types --test tests/local-config.test.ts",
    "db:check": "node --env-file-if-exists=.env -e \"const {spawnSync}=require('node:child_process'); const r=spawnSync('python3',['scripts/db_readiness.py'],{stdio:'inherit'}); process.exitCode=r.status ?? 1\"",
    "db:validate": "pnpm --filter @construct-ai/database db:validate",
    "db:generate": "pnpm --filter @construct-ai/database db:generate",
    "db:smoke": "pnpm --filter @construct-ai/database db:smoke",
    "smoke:http": "node --env-file-if-exists=.env scripts/http-smoke.mjs",
    "test:http": "node --test tests/http-smoke.test.mjs",
    "smoke:storage": "node --env-file-if-exists=.env scripts/storage-smoke.mjs",
    "test:storage": "node --test tests/storage-smoke.test.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "5.9.3"
  }
}
